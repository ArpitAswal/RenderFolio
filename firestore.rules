rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: resumes
    // Document ID: {shareId} (e.g. shortUid_randomToken)
    // Fields:
    //   - shareId: string (required, 1-64 chars) - Unique showcase slug matching document ID
    //   - ownerUid: string (required, 1-128 chars) - Firebase Auth UID of the creator (immutable)
    //   - candidateName: string (required, 1-100 chars) - Candidate display name
    //   - headline: string (required, 1-200 chars) - Professional title / role headline
    //   - targetCompany: string (required, 0-100 chars) - Targeted company name (can be empty string)
    //   - profileJson: string (required, 2-500000 chars) - Serialized ResumeProfile JSON payload
    //   - createdAt: timestamp (required, server/recent timestamp) - Creation timestamp (immutable)
    //   - expireAt: timestamp (required, future timestamp, <= 8 days) - 7-day TTL expiration timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerUid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isRecent(time) {
      return time is timestamp &&
             time > request.time - duration.value(5, 'm') &&
             time <= request.time;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validator (Validator Function Pattern)
    // ===============================================================

    function isValidResume(data, docShareId) {
      return hasRequiredFields([
               'shareId', 'ownerUid', 'candidateName', 'headline',
               'targetCompany', 'profileJson', 'createdAt', 'expireAt'
             ]) &&
             hasOnlyAllowedFields([
               'shareId', 'ownerUid', 'candidateName', 'headline',
               'targetCompany', 'profileJson', 'createdAt', 'expireAt'
             ]) &&
             data.shareId is string &&
             data.shareId == docShareId &&
             data.shareId.size() >= 1 && data.shareId.size() <= 64 &&
             data.ownerUid is string &&
             data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.candidateName is string &&
             data.candidateName.size() >= 1 && data.candidateName.size() <= 100 &&
             data.headline is string &&
             data.headline.size() >= 1 && data.headline.size() <= 200 &&
             data.targetCompany is string &&
             data.targetCompany.size() <= 100 &&
             data.profileJson is string &&
             data.profileJson.size() >= 2 && data.profileJson.size() <= 500000 &&
             data.createdAt is timestamp &&
             data.expireAt is timestamp &&
             data.expireAt > data.createdAt &&
             data.expireAt <= data.createdAt + duration.value(8, 'd');
    }

    // ===============================================================
    // Scoped Rules: resumes collection
    // ===============================================================

    match /resumes/{shareId} {
      // 1. Direct document retrieval (get):
      // Allowed for any authenticated user (including anonymous web viewers) holding
      // the shareId while active (before expireAt), or for the owner at any time.
      // If expired, reads by third parties are strictly denied.
      allow get: if isAuthenticated() && (
        isDocOwner() ||
        request.time < resource.data.expireAt
      );

      // 2. Collection queries (list):
      // Scoped strictly to the owner's documents (e.g. whereEqualTo("ownerUid", user.uid)).
      // Prevents global scraping and enumeration of candidate resumes.
      allow list: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid
      );

      // 3. Document creation (create):
      // Enforces authentication, ownerUid matching caller UID, recent/server timestamp,
      // and thorough schema, type, and size validations.
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       (request.resource.data.createdAt == request.time || isRecent(request.resource.data.createdAt)) &&
                       isValidResume(request.resource.data, shareId);

      // 4. Document updates (update):
      // Only the owner can update prior to expiration, enforcing schema validity
      // and protecting immutable identity and timestamp fields.
      allow update: if isAuthenticated() &&
                       isDocOwner() &&
                       request.time < resource.data.expireAt &&
                       areImmutableFieldsUnchanged(['shareId', 'ownerUid', 'createdAt']) &&
                       isValidResume(request.resource.data, shareId);

      // 5. Document deletion (delete):
      // Allowed if the requester owns the resume OR if the resume is expired (TTL purge).
      allow delete: if isAuthenticated() && (
        isDocOwner() ||
        request.time >= resource.data.expireAt
      );
    }

    // ===============================================================
    // Shared Database Integration Note:
    // ===============================================================
    // To support other collections in this shared database without breaking them,
    // declare their explicit match blocks below. Avoid a root wildcard /{document=**}
    // because rules are evaluated as a logical OR and any permissive wildcard rule
    // would bypass the protections defined for /resumes/{shareId}.
    //
    // Example for other collections:
    // match /otherCollection/{docId} {
    //   allow read, write: if request.auth != null;
    // }
  }
}
