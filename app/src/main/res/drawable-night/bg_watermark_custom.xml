<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 3D Isometric Medallion Crest & Star Credential Seal (Night Mode): -15 degree rotation around center (105, 95), dark obsidian frosted glass with electric blue rim -->
    <group
        android:pivotX="105"
        android:pivotY="95"
        android:rotation="-15">

        <!-- Cascading Ribbon Tails Flowing Beneath Medallion -->
        <!-- Left Draped Ribbon Tail with V-Notch End -->
        <path
            android:pathData="M 92,116 L 74,170 L 92,158 L 102,170 L 98,120 Z"
            android:strokeWidth="1.2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="74"
                    android:startY="116"
                    android:endX="102"
                    android:endY="170">
                    <item android:offset="0.0" android:color="#732A3548" />
                    <item android:offset="0.6" android:color="#3318202C" />
                    <item android:offset="1.0" android:color="#143B82F6" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="74"
                    android:startY="116"
                    android:endX="102"
                    android:endY="170">
                    <item android:offset="0.0" android:color="#66FFFFFF" />
                    <item android:offset="1.0" android:color="#593B82F6" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right Draped Ribbon Tail with V-Notch End -->
        <path
            android:pathData="M 112,120 L 108,170 L 118,158 L 136,170 L 118,116 Z"
            android:strokeWidth="1.2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="108"
                    android:startY="116"
                    android:endX="136"
                    android:endY="170">
                    <item android:offset="0.0" android:color="#732A3548" />
                    <item android:offset="0.6" android:color="#3318202C" />
                    <item android:offset="1.0" android:color="#143B82F6" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="108"
                    android:startY="116"
                    android:endX="136"
                    android:endY="170">
                    <item android:offset="0.0" android:color="#66FFFFFF" />
                    <item android:offset="1.0" android:color="#593B82F6" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Ribbon Accent Spine Lines -->
        <path
            android:pathData="M 88,122 L 83,164 M 122,122 L 127,164"
            android:fillColor="#00000000"
            android:strokeColor="#593B82F6"
            android:strokeWidth="1.0" />

        <!-- Outer Medallion Seal (Dark Frosted Glass Fill + Specular Rim) -->
        <path
            android:pathData="M 105,36 C 129.3,36 149,55.7 149,80 C 149,104.3 129.3,124 105,124 C 80.7,124 61,104.3 61,80 C 61,55.7 80.7,36 105,36 Z"
            android:strokeWidth="1.2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="61"
                    android:startY="36"
                    android:endX="149"
                    android:endY="124">
                    <item android:offset="0.0" android:color="#802A3548" />
                    <item android:offset="0.5" android:color="#4018202C" />
                    <item android:offset="1.0" android:color="#143B82F6" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="61"
                    android:startY="36"
                    android:endX="149"
                    android:endY="124">
                    <item android:offset="0.0" android:color="#73FFFFFF" />
                    <item android:offset="0.5" android:color="#663B82F6" />
                    <item android:offset="1.0" android:color="#332A3548" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Concentric Inner Blue Accent Ring -->
        <path
            android:pathData="M 105,44 C 124.9,44 141,60.1 141,80 C 141,99.9 124.9,116 105,116 C 85.1,116 69,99.9 69,80 C 69,60.1 85.1,44 105,44 Z"
            android:fillColor="#00000000"
            android:strokeColor="#663B82F6"
            android:strokeWidth="1.2" />

        <!-- Innermost Refraction Ring -->
        <path
            android:pathData="M 105,52 C 120.5,52 133,64.5 133,80 C 133,95.5 120.5,108 105,108 C 89.5,108 77,95.5 77,80 C 77,64.5 89.5,52 105,52 Z"
            android:fillColor="#00000000"
            android:strokeColor="#4DFFFFFF"
            android:strokeWidth="0.8" />

        <!-- Central 5-Pointed Faceted Star of Excellence -->
        <path
            android:pathData="M 105,58 L 111,73 L 126,73.5 L 114,83 L 118,98 L 105,88 L 92,98 L 96,83 L 84,73.5 L 99,73 Z"
            android:fillColor="#593B82F6"
            android:strokeColor="#803B82F6"
            android:strokeWidth="1.0" />

        <!-- Star Central Specular Facet Line -->
        <path
            android:pathData="M 105,58 L 105,88"
            android:fillColor="#00000000"
            android:strokeColor="#80FFFFFF"
            android:strokeWidth="1.0" />

        <!-- Laurel Wreath Foliage (Left Branch) -->
        <path
            android:pathData="M 63,80 C 63,64 72,50 82,42"
            android:fillColor="#00000000"
            android:strokeColor="#593B82F6"
            android:strokeWidth="1.0" />

        <path
            android:pathData="M 60,74 C 54,72 54,66 58,68 C 61,70 61,73 60,74 Z"
            android:fillColor="#333B82F6" />

        <path
            android:pathData="M 65,60 C 59,57 60,51 64,53 C 67,55 67,58 65,60 Z"
            android:fillColor="#333B82F6" />

        <path
            android:pathData="M 74,48 C 69,44 71,39 75,41 C 77,43 76,46 74,48 Z"
            android:fillColor="#333B82F6" />

        <!-- Laurel Wreath Foliage (Right Branch) -->
        <path
            android:pathData="M 147,80 C 147,64 138,50 128,42"
            android:fillColor="#00000000"
            android:strokeColor="#593B82F6"
            android:strokeWidth="1.0" />

        <path
            android:pathData="M 150,74 C 156,72 156,66 152,68 C 149,70 149,73 150,74 Z"
            android:fillColor="#333B82F6" />

        <path
            android:pathData="M 145,60 C 151,57 150,51 146,53 C 143,55 143,58 145,60 Z"
            android:fillColor="#333B82F6" />

        <path
            android:pathData="M 136,48 C 141,44 139,39 135,41 C 133,43 134,46 136,48 Z"
            android:fillColor="#333B82F6" />

    </group>

</vector>

