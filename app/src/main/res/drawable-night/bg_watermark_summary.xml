            android:pathData="M 97,23 h 24 a 2,2 0 0 1 2,2 v 0 a 2,2 0 0 1 -2,2 h -24 a 2,2 0 0 1 -2,-2 v 0 a 2,2 0 0 1 2,-2 Z"
            android:fillColor="#593B82F6" />

        <!-- Refined Isometric Internal Code / Interface Traces -->
        <!-- Trace 1 -->
        <path
            android:pathData="M 84.5,46 h 35 a 2.5,2.5 0 0 1 2.5,2.5 a 2.5,2.5 0 0 1 -2.5,2.5 h -35 a 2.5,2.5 0 0 1 -2.5,-2.5 a 2.5,2.5 0 0 1 2.5,-2.5 Z"
