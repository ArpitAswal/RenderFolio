    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Isometric Frosted Tech Asset (Night Mode): -15 degree rotation around center (109, 96), obsidian dark frosted glass and royal electric blue accents -->
