<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Dark Slate Base #0D0D11 -->
    <item>
        <color android:color="#0D0D11" />
    </item>
    <!-- Soft blue (#3B82F6) glow top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0.05"
                android:centerY="0.05"
                android:startColor="#263B82F6"
                android:endColor="#000D0D11" />
        </shape>
    </item>
    <!-- Soft purple (#8B5CF6) glow center-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="380dp"
                android:centerX="0.95"
                android:centerY="0.45"
                android:startColor="#1E8B5CF6"
                android:endColor="#000D0D11" />
        </shape>
    </item>
</layer-list>
