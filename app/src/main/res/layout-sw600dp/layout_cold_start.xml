<?xml version="1.0" encoding="utf-8"?>
<!--
    Cold-Start PDF Attachment Screen (Tablet Portrait Layout: sw600dp)
    Paradigm: 100% Pure XML (Centered Single Column with Bounded Max Width)
    Features:
      - Centered column bounded to max-width 560dp
      - Spacious tablet paddings (@dimen/screen_padding_horizontal: 48dp)
      - Non-clickable MaterialCardView dropzone with dedicated Upload button
      - WCAG AA compliant text contrast ratios
      - Natural wrap_content button widths centered horizontally
      - Consistent 20dp corner radius on cards, 14dp on buttons
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_cold_start"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <!-- ConstraintLayout to strictly enforce max-width on tablet portrait -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_vertical"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/screen_padding_vertical">

        <!-- Centered Content Column bounded to max 560dp -->
        <LinearLayout
            android:id="@+id/container_tablet_portrait_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="560dp">

            <!-- Brand Badge: "RenderFolio" -->
            <LinearLayout
                android:id="@+id/layout_brand_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_description"
                    app:tint="@color/app_primary" />

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/cold_start_app_title"
                    android:textColor="@color/app_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Header Section: Display Headline & Subtitle -->
            <LinearLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/cold_start_headline"
                    android:textColor="@color/app_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/cold_start_subtitle"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Dedicated Upload Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_dropzone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:clickable="false"
                android:focusable="false"
                app:cardBackgroundColor="@color/app_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="36dp"
                    android:paddingTop="40dp"
                    android:paddingEnd="36dp"
                    android:paddingBottom="40dp">

                    <!-- Upload Circle Badge -->
                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_upload_icon">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cloud_upload"
                            app:tint="@color/app_primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_dropzone_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/cold_start_dropzone_title"
                        android:textColor="@color/app_text_primary"
                        android:textSize="18sp" />

                    <!-- Primary Action Button: "Upload Resume" -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_upload_pdf"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:minWidth="220dp"
                        android:paddingHorizontal="28dp"
                        android:text="@string/cold_start_action_button"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/app_primary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_description"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@android:color/white" />

                    <!-- Helper Subtext: "Supports PDF up to 10MB" -->
                    <TextView
                        android:id="@+id/tv_file_limit_note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/cold_start_file_limit"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Conditional Action Container (Explore Demo / Active Showcase Actions) -->
            <FrameLayout
                android:id="@+id/container_cold_start_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <!-- Explore Demo Showcase Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_load_demo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:minWidth="240dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/cold_start_demo_button"
                    android:textAllCaps="false"
                    android:textColor="@color/app_primary"
                    android:textSize="14sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/app_primary"
                    app:strokeColor="@color/app_primary"
                    app:strokeWidth="1.5dp" />

                <!-- Returning User Pathway -->
                <LinearLayout
                    android:id="@+id/layout_active_showcase_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_active_visualiser"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="48dp"
                        android:minWidth="260dp"
                        android:paddingHorizontal="24dp"
                        android:text="@string/btn_view_visualiser"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/app_primary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_visibility"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@android:color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_show_active_qr"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="48dp"
                        android:minWidth="260dp"
                        android:paddingHorizontal="24dp"
                        android:text="@string/btn_show_qr_code"
                        android:textAllCaps="false"
                        android:textColor="@color/app_primary"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_qr_code"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/app_primary"
                        app:strokeColor="@color/app_primary"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Privacy Note Pill -->
            <LinearLayout
                android:id="@+id/layout_privacy_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_privacy_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/cold_start_privacy_note"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Format Note -->
            <TextView
                android:id="@+id/tv_format_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/cold_start_format_note"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

