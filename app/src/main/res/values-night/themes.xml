<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">#DBEAFE</item>
        <item name="colorSecondary">#94A3B8</item>
        <item name="colorSecondaryContainer">@color/chip_bg_color</item>
        <item name="colorOnSecondaryContainer">@color/chip_text_color</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorSurfaceVariant">@color/chip_bg_color</item>
        <item name="colorOnSurfaceVariant">@color/app_text_muted</item>
        <item name="colorOutline">@color/chip_stroke_color</item>
        <item name="colorOutlineVariant">@color/app_border</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorTertiary">@color/app_primary</item>
        <item name="colorTertiaryContainer">@color/chip_bg_color</item>
        <item name="colorOnTertiaryContainer">@color/chip_text_color</item>
        <item name="chipStyle">@style/Widget.App.SkillChip</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <!-- Dedicated Theme for ResumeVisualiserActivity (Atmospheric Canvas - Night) -->
    <style name="Theme.ResumeVisualiser" parent="Theme.MyApplication">
        <item name="android:windowBackground">@drawable/bg_canvas_ambient</item>
        <item name="android:statusBarColor">@color/ambient_canvas_start</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface</item>
        <item name="colorSurfaceContainer">@color/app_surface</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface</item>
        <item name="colorSurfaceContainerLow">@color/app_surface</item>
        <item name="colorSurfaceContainerLowest">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/app_text_muted</item>
        <item name="colorPrimary">@color/app_primary</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="backgroundTint">@color/app_surface</item>
        <item name="android:backgroundTint">@color/app_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Dialog</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.App.SkillChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="chipStrokeColor">@color/chip_stroke_color</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="closeIconTint">@color/chip_close_icon_tint</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="colorSurfaceContainerLow">@color/app_surface</item>
        <item name="bottomSheetStyle">@style/AppModalBottomSheet</item>
    </style>

    <style name="AppModalBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/app_surface</item>
    </style>
</resources>
