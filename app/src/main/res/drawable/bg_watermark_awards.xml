<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 3D Isometric Champion's Trophy Cup: -15 degree rotation around center (105, 95) -->
    <group
        android:pivotX="105"
        android:pivotY="95"
        android:rotation="-15">

        <!-- Trophy Chalice Cup Body (Frosted Glass Fill + Specular Rim) -->
        <path
            android:pathData="M 72,42 h 66 c 0,32 -13,54 -33,54 c -20,0 -33,-22 -33,-54 Z"
            android:strokeWidth="1.2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="72"
                    android:startY="42"
                    android:endX="138"
                    android:endY="96">
                    <item android:offset="0.0" android:color="#80FFFFFF" />
                    <item android:offset="0.5" android:color="#33FFFFFF" />
                    <item android:offset="1.0" android:color="#08FFFFFF" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="72"
                    android:startY="42"
                    android:endX="138"
                    android:endY="96">
                    <item android:offset="0.0" android:color="#E6FFFFFF" />
                    <item android:offset="0.4" android:color="#99FFFFFF" />
                    <item android:offset="1.0" android:color="#33FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Trophy Rim Lip at Top -->
        <path
            android:pathData="M 68,36 h 74 a 3,3 0 0 1 3,3 v 3 a 3,3 0 0 1 -3,3 h -74 a 3,3 0 0 1 -3,-3 v -3 a 3,3 0 0 1 3,-3 Z"
            android:fillColor="#33FFFFFF"
            android:strokeColor="#80FFFFFF"
            android:strokeWidth="1.0" />

        <!-- Left Sculpted Handle -->
        <path
            android:pathData="M 72,50 C 48,50 48,78 72,82"
            android:fillColor="#00000000"
            android:strokeColor="#332563EB"
            android:strokeWidth="2.8" />
        <path
            android:pathData="M 72,54 C 54,54 54,74 72,78"
            android:fillColor="#00000000"
            android:strokeColor="#44FFFFFF"
            android:strokeWidth="1.0" />

        <!-- Right Sculpted Handle -->
        <path
            android:pathData="M 138,50 C 162,50 162,78 138,82"
            android:fillColor="#00000000"
            android:strokeColor="#332563EB"
            android:strokeWidth="2.8" />
        <path
            android:pathData="M 138,54 C 156,54 156,74 138,78"
            android:fillColor="#00000000"
            android:strokeColor="#44FFFFFF"
            android:strokeWidth="1.0" />

        <!-- Trophy Stem Column -->
        <path
            android:pathData="M 101,96 h 8 v 24 h -8 Z"
            android:fillColor="#222563EB"
            android:strokeColor="#442563EB"
            android:strokeWidth="1.0" />

        <!-- Trophy Pedestal Base Tier 1 -->
        <path
            android:pathData="M 88,120 h 34 a 3,3 0 0 1 3,3 v 8 a 3,3 0 0 1 -3,3 h -34 a 3,3 0 0 1 -3,-3 v -8 a 3,3 0 0 1 3,-3 Z"
            android:fillColor="#26FFFFFF"
            android:strokeColor="#66FFFFFF"
            android:strokeWidth="1.0" />

        <!-- Trophy Pedestal Base Tier 2 (Weighted Plinth) -->
        <path
            android:pathData="M 76,134 h 58 a 4,4 0 0 1 4,4 v 16 a 4,4 0 0 1 -4,4 h -58 a 4,4 0 0 1 -4,-4 v -16 a 4,4 0 0 1 4,-4 Z"
            android:strokeWidth="1.2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="76"
                    android:startY="134"
                    android:endX="134"
                    android:endY="158">
                    <item android:offset="0.0" android:color="#70FFFFFF" />
                    <item android:offset="1.0" android:color="#1A2563EB" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="76"
                    android:startY="134"
                    android:endX="134"
                    android:endY="158">
                    <item android:offset="0.0" android:color="#CCFFFFFF" />
                    <item android:offset="1.0" android:color="#332563EB" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Star Insignia on Cup -->
        <path
            android:pathData="M 105,55 L 107.5,62.5 L 115,63 L 109,68 L 111,76 L 105,71.5 L 99,76 L 101,68 L 95,63 L 102.5,62.5 Z"
            android:fillColor="#332563EB"
            android:strokeColor="#662563EB"
            android:strokeWidth="0.8" />

    </group>

</vector>
