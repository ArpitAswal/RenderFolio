<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism Monogram Syllable Circle (Frosted Soft Gradient + Outer Stroke Ring) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/hero_avatar_glass_start"
        android:endColor="@color/hero_avatar_glass_end" />
    <stroke
        android:width="3dp"
        android:color="@color/hero_avatar_glass_stroke" />
</shape>

