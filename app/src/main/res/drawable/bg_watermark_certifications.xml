<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 3D Isometric Diploma / Certificate Parchment with Seal: -15 degree rotation around center (105, 95) -->
    <group
        android:pivotX="105"
        android:pivotY="95"
        android:rotation="-15">

        <!-- Outer Parchment Certificate Document (Frosted Glass Fill + Specular Rim) -->
        <path
            android:pathData="M 58,34 h 94 a 10,10 0 0 1 10,10 v 112 a 10,10 0 0 1 -10,10 h -94 a 10,10 0 0 1 -10,-10 v -112 a 10,10 0 0 1 10,-10 Z"
            android:strokeWidth="1.2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="48"
                    android:startY="30"
                    android:endX="162"
                    android:endY="166">
                    <item android:offset="0.0" android:color="#80FFFFFF" />
                    <item android:offset="0.5" android:color="#33FFFFFF" />
                    <item android:offset="1.0" android:color="#08FFFFFF" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="48"
                    android:startY="30"
                    android:endX="162"
                    android:endY="166">
                    <item android:offset="0.0" android:color="#E6FFFFFF" />
                    <item android:offset="0.4" android:color="#99FFFFFF" />
                    <item android:offset="1.0" android:color="#33FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Certificate Ornamental Border -->
        <path
            android:pathData="M 64,40 h 82 a 6,6 0 0 1 6,6 v 100 a 6,6 0 0 1 -6,6 h -82 a 6,6 0 0 1 -6,-6 v -100 a 6,6 0 0 1 6,-6 Z"
            android:fillColor="#00000000"
            android:strokeColor="#332563EB"
            android:strokeWidth="0.9" />

        <!-- Header Ribbon / Banner Crest at Top -->
        <path
            android:pathData="M 76,52 h 58 a 3,3 0 0 1 3,3 v 8 a 3,3 0 0 1 -3,3 h -58 a 3,3 0 0 1 -3,-3 v -8 a 3,3 0 0 1 3,-3 Z"
            android:fillColor="#222563EB"
            android:strokeColor="#442563EB"
            android:strokeWidth="0.8" />

        <!-- Certificate Body Lines (Simulating Authority Text) -->
        <path
            android:pathData="M 72,74 h 66 M 72,84 h 54 M 72,94 h 66 M 72,104 h 42"
            android:fillColor="#00000000"
            android:strokeColor="#332563EB"
            android:strokeWidth="1.0" />

        <!-- Ribbon Tails Hanging from Bottom of Seal -->
        <path
            android:pathData="M 97,136 L 91,162 L 98,156 L 105,162 L 101,138"
            android:fillColor="#332563EB"
            android:strokeColor="#442563EB"
            android:strokeWidth="0.8" />
        <path
            android:pathData="M 109,138 L 105,162 L 112,156 L 119,162 L 113,136"
            android:fillColor="#332563EB"
            android:strokeColor="#442563EB"
            android:strokeWidth="0.8" />

        <!-- Official Wax/Gold Rosette Seal -->
        <path
            android:pathData="M 105,110 a 16,16 0 1 1 0,32 a 16,16 0 1 1 0,-32"
            android:strokeWidth="1.2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="89"
                    android:startY="110"
                    android:endX="121"
                    android:endY="142">
                    <item android:offset="0.0" android:color="#99FFFFFF" />
                    <item android:offset="1.0" android:color="#332563EB" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="89"
                    android:startY="110"
                    android:endX="121"
                    android:endY="142">
                    <item android:offset="0.0" android:color="#FFFFFFFF" />
                    <item android:offset="1.0" android:color="#662563EB" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Star Crest Inside Seal -->
        <path
            android:pathData="M 105,117 L 107.2,122.8 L 113,123.3 L 108.5,127.1 L 110,133 L 105,129.8 L 100,133 L 101.5,127.1 L 97,123.3 L 102.8,122.8 Z"
            android:fillColor="#442563EB"
            android:strokeColor="#662563EB"
            android:strokeWidth="0.8" />

    </group>

</vector>
