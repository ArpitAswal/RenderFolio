<?xml version="1.0" encoding="utf-8"?>
<!-- Ripple container ensuring visual feedback + compliant 48dp touch bounds -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/hero_chip_ripple">
    <item>
        <shape android:shape="rectangle">
            <!-- 12dp pill corner radius -->
            <corners android:radius="12dp" />
            <solid android:color="@color/hero_chip_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/hero_chip_stroke" />
        </shape>
    </item>
</ripple>
