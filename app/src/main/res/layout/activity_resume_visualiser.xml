<?xml version="1.0" encoding="utf-8"?>
<!-- 100% Pure XML Root CoordinatorLayout (Zero Hybrid Rule) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_canvas_ambient"
    android:fitsSystemWindows="true">

    <!-- Centered Indeterminate Loading for Deep Link Ingestion -->
    <ProgressBar
        android:id="@+id/pb_visualiser_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/app_primary"
        android:visibility="gone" />

    <!-- NestedScrollView driving the whole-section motion physics -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="invisible"
        android:background="@drawable/bg_canvas_ambient"
        android:overScrollMode="always">

        <!-- Outer Column Centered to Screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="36dp"
            android:paddingBottom="48dp">

            <!-- SECTION 1: HERO CONTAINER (Target for Whole-Section Animation) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/hero_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="680dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- 1. Floating Glass Avatar Unit (Glassmorphism Syllable Disc + Verified Rosette Badge) -->
                <FrameLayout
                    android:id="@+id/layout_hero_avatar_wrapper"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_hero_avatar_glass"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tv_hero_initials"
                        style="@style/TextAppearance.ResumeVisualiser.Hero.Initials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/hero_default_initials"
                        tools:text="AA" />

                    <!-- Verified Rosette Checkmark Badge (media_1793966472413_4e8f09ec spec) -->
                    <FrameLayout
                        android:id="@+id/layout_hero_verified_badge"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="1dp"
                        android:layout_marginBottom="1dp"
                        android:background="@drawable/bg_hero_verified_badge">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_star_badge_16"
                            app:tint="@android:color/white"
                            android:contentDescription="@string/cd_hero_verified" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 2. Candidate Full Name (Centered) -->
                <TextView
                    android:id="@+id/tv_hero_name"
                    style="@style/TextAppearance.ResumeVisualiser.Hero.Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/hero_name_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_hero_avatar_wrapper" />

                <!-- 3. Professional Headline / Title (Centered) -->
                <TextView
                    android:id="@+id/tv_hero_headline"
                    style="@style/TextAppearance.ResumeVisualiser.Hero.Headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_hero_name" />

                <!-- 4. Floating Location Capsule Chip (Centered, Alex Morgan spec) -->
                <TextView
                    android:id="@+id/tv_hero_location"
                    style="@style/TextAppearance.ResumeVisualiser.Hero.Location"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_hero_location_pill"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:drawablePadding="6dp"
                    app:drawableStartCompat="@drawable/ic_location_pin_16"
                    app:drawableTint="@color/hero_location_pill_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_hero_headline" />

                <!-- 5. Primary Glass CTA ("Email Alex" / "Email Arpit" - Borderless Floating Spec) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_action_email"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/btn_hero_email"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/app_primary"
                    app:strokeColor="@color/hero_email_glass_stroke"
                    app:strokeWidth="1dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_email_18"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@android:color/white"
                    app:cornerRadius="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintWidth_max="360dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_hero_location" />

                <!-- 6. Secondary Quick-Contact Dock (4 Frosted Squircle Tiles - Borderless Spec) -->
                <LinearLayout
                    android:id="@+id/layout_social_dock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:gravity="center"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintWidth_max="360dp"
                    app:layout_constraintTop_toBottomOf="@id/btn_action_email"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Phone Call Tile -->
                    <FrameLayout
                        android:id="@+id/btn_action_call"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_social_dock_button"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_phone_18"
                            app:tint="@color/hero_name_text"
                            android:contentDescription="@string/cd_hero_phone" />
                    </FrameLayout>

                    <!-- GitHub Tile -->
                    <FrameLayout
                        android:id="@+id/btn_social_github"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_social_dock_button"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_github_20"
                            app:tint="@color/hero_name_text"
                            android:contentDescription="@string/cd_hero_profile_link" />
                    </FrameLayout>

                    <!-- LinkedIn Tile -->
                    <FrameLayout
                        android:id="@+id/btn_social_linkedin"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_social_dock_button"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_linkedin_20"
                            android:contentDescription="@string/cd_hero_profile_link" />
                    </FrameLayout>

                    <!-- Portfolio / Website Tile -->
                    <FrameLayout
                        android:id="@+id/btn_social_portfolio"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_social_dock_button"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_link_20"
                            app:tint="@color/hero_name_text"
                            android:contentDescription="@string/cd_hero_profile_link" />
                    </FrameLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- SECTION 2: PROFESSIONAL OVERVIEW & SUMMARY -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="680dp"
                android:layout_marginTop="32dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <include
                    android:id="@+id/included_section_summary"
                    layout="@layout/layout_section_summary" />
            </FrameLayout>

            <!-- SECTION 3: WORK EXPERIENCE -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="680dp"
                android:layout_marginTop="32dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <include
                    android:id="@+id/included_section_experience"
                    layout="@layout/layout_section_work_experience" />
            </FrameLayout>

            <!-- SECTION 4: FEATURED PROJECTS -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="680dp"
                android:layout_marginTop="32dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <include
                    android:id="@+id/included_section_projects"
                    layout="@layout/layout_section_projects" />
            </FrameLayout>

            <!-- SECTION 5: TECHNICAL SKILLS -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="680dp"
                android:layout_marginTop="32dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <include
                    android:id="@+id/included_section_skills"
                    layout="@layout/layout_section_technical_skills" />
            </FrameLayout>


            <!-- SECTION 6: EDUCATION -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="680dp"
                android:layout_marginTop="32dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <include
                    android:id="@+id/included_section_education"
                    layout="@layout/layout_section_education" />
            </FrameLayout>

            <!-- SECTION 7: ALL CUSTOM DYNAMIC SECTIONS -->
            <LinearLayout
                android:id="@+id/container_custom_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:maxWidth="680dp"
                android:layout_marginTop="32dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
