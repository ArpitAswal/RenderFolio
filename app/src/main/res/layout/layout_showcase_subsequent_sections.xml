<?xml version="1.0" encoding="utf-8"?>
<!-- Subsequent Sections (2..7) embedded into Section 1's container_content_sections -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 5. TECHNICAL COMPETENCIES (TEXT LEFT | THEMATIC GRAPHIC RIGHT) -->
    <FrameLayout
        android:id="@+id/sectionTechnicalCompetencies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp">

        <!-- Right-aligned background vector graphic overlay (15% opacity) -->
        <ImageView
            android:id="@+id/ivGraphicTechnicalCompetencies"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|end"
            android:alpha="0.15"
            android:contentDescription="@string/cd_showcase_technical_graphic"
            android:src="@drawable/ic_showcase_tech_matrix" />

        <!-- Left Text Content & Categorized Groups -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTechnicalCompetenciesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/header_showcase_technical_competencies"
                android:textAllCaps="true"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Languages -->
            <LinearLayout
                android:id="@+id/groupLanguages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_showcase_languages"
                    android:textColor="@color/app_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupLanguages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:singleLine="false" />
            </LinearLayout>

            <!-- Frameworks & SDKs -->
            <LinearLayout
                android:id="@+id/groupFrameworks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_showcase_frameworks"
                    android:textColor="@color/app_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFrameworks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:singleLine="false" />
            </LinearLayout>

            <!-- Cloud & DevOps -->
            <LinearLayout
                android:id="@+id/groupCloudDevOps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_showcase_cloud_devops"
                    android:textColor="@color/app_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCloudDevOps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:singleLine="false" />
            </LinearLayout>

            <!-- Tools & Methodologies -->
            <LinearLayout
                android:id="@+id/groupTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_showcase_tools"
                    android:textColor="@color/app_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupTools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:singleLine="false" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- 6. EDUCATIONAL BACKGROUND (THEMATIC GRAPHIC LEFT | TEXT RIGHT) -->
    <FrameLayout
        android:id="@+id/sectionEducation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp">

        <!-- Left-aligned background vector graphic overlay (15% opacity) -->
        <ImageView
            android:id="@+id/ivGraphicEducation"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|start"
            android:alpha="0.15"
            android:contentDescription="@string/cd_showcase_education_graphic"
            android:src="@drawable/ic_showcase_education_crest" />

        <!-- Right Text Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEducationHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/header_showcase_education"
                android:textAllCaps="true"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerEducationItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

    </FrameLayout>

    <!-- 7. DYNAMIC CUSTOM SECTIONS (IF PRESENT) -->
    <LinearLayout
        android:id="@+id/containerDynamicSections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

</LinearLayout>
