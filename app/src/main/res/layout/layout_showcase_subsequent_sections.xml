<?xml version="1.0" encoding="utf-8"?>
<!-- Subsequent Sections (2..7) embedded into Section 1's container_content_sections -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 6. EDUCATIONAL BACKGROUND (THEMATIC GRAPHIC LEFT | TEXT RIGHT) -->
    <FrameLayout
        android:id="@+id/sectionEducation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp">

        <!-- Left-aligned background vector graphic overlay (15% opacity) -->
        <ImageView
            android:id="@+id/ivGraphicEducation"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|start"
            android:alpha="0.15"
            android:contentDescription="@string/cd_showcase_education_graphic"
            android:src="@drawable/ic_showcase_education_crest" />

        <!-- Right Text Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEducationHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/header_showcase_education"
                android:textAllCaps="true"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerEducationItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

    </FrameLayout>

    <!-- 7. DYNAMIC CUSTOM SECTIONS (IF PRESENT) -->
    <LinearLayout
        android:id="@+id/containerDynamicSections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

</LinearLayout>
