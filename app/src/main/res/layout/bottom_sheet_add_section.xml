<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Bottom sheet drag handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/app_border" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/add_custom_section"
        android:textColor="@color/app_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/add_section_subtitle"
        android:textColor="@color/app_text_muted"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/recommended_templates"
        android:textColor="@color/app_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Templates ChipGroup -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTemplates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:singleLine="false">

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_color"
            app:chipStrokeColor="@color/chip_stroke_color"
            app:chipStrokeWidth="1dp"
            app:chipCornerRadius="8dp"
            android:textColor="@color/chip_text_color"
            android:text="@string/template_certifications" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_color"
            app:chipStrokeColor="@color/chip_stroke_color"
            app:chipStrokeWidth="1dp"
            app:chipCornerRadius="8dp"
            android:textColor="@color/chip_text_color"
            android:text="@string/template_achievements" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_color"
            app:chipStrokeColor="@color/chip_stroke_color"
            app:chipStrokeWidth="1dp"
            app:chipCornerRadius="8dp"
            android:textColor="@color/chip_text_color"
            android:text="@string/template_publications" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_color"
            app:chipStrokeColor="@color/chip_stroke_color"
            app:chipStrokeWidth="1dp"
            app:chipCornerRadius="8dp"
            android:textColor="@color/chip_text_color"
            android:text="@string/template_languages" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_color"
            app:chipStrokeColor="@color/chip_stroke_color"
            app:chipStrokeWidth="1dp"
            app:chipCornerRadius="8dp"
            android:textColor="@color/chip_text_color"
            android:text="@string/template_volunteer_work" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_color"
            app:chipStrokeColor="@color/chip_stroke_color"
            app:chipStrokeWidth="1dp"
            app:chipCornerRadius="8dp"
            android:textColor="@color/chip_text_color"
            android:text="@string/template_honors_awards" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Custom Section Title Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCustomSectionTitle"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="@string/hint_custom_section_title"
        app:errorEnabled="true"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:startIconDrawable="@drawable/ic_work"
        app:startIconTint="@color/app_primary"
        app:startIconMinSize="44dp"
        app:helperText="@string/helper_required"
        app:helperTextEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCustomSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="46dp"
            android:paddingEnd="12dp"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/app_text_primary" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmAddSection"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/action_add_section"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/app_primary"
        app:cornerRadius="12dp" />

</LinearLayout>
