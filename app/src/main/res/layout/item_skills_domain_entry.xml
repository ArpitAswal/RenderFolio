<?xml version="1.0" encoding="utf-8"?>
<!-- Single Skill Category Row with Domain Label, Edit Action, and Midpoint Stream -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_skills_domain_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <!-- Domain Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDomainTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/app_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.04" />

        <ImageView
            android:id="@+id/btnEditDomain"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_edit_domain_skills"
            android:padding="6dp"
            android:src="@drawable/ic_edit_outline_16"
            app:tint="@color/app_text_muted" />

        <ImageView
            android:id="@+id/btnDeleteDomain"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_delete_domain"
            android:padding="6dp"
            android:src="@drawable/ic_delete_outline_16"
            app:tint="@color/app_danger" />
    </LinearLayout>

    <!-- Inline Skills Stream (Midpoint-dot separated or bulleted text) -->
    <TextView
        android:id="@+id/tvDomainSkillsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="4sp"
        android:textColor="@color/app_text_secondary"
        android:textSize="13sp" />

    <View
        android:id="@+id/dividerDomain"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/app_border" />

</LinearLayout>
