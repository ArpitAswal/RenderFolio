<?xml version="1.0" encoding="utf-8"?>
<!-- Container Target for the Credential Scale Reveal Motion & Faded Background Watermark -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section_custom_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Faded Thematic Background Watermark Artwork (3D Isometric Medallion Crest & Star Seal) -->
    <ImageView
        android:id="@+id/iv_custom_watermark"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-20dp"
        android:layout_marginEnd="-28dp"
        android:alpha="0.75"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_watermark_custom" />

    <!-- Content Column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Custom Section Title (e.g. CERTIFICATIONS / OPEN SOURCE CONTRIBUTIONS) -->
        <TextView
            android:id="@+id/tv_custom_section_title"
            style="@style/TextAppearance.ResumeVisualiser.Section.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_star_badge_16"
            app:drawableTint="@color/summary_section_title" />

        <!-- Container for Items inside this Custom Section -->
        <LinearLayout
            android:id="@+id/container_custom_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</FrameLayout>
