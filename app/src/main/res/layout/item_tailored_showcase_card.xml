<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_tailored_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_showcase_selector_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <!-- Company Initial Avatar Badge / Leading Icon (44dp x 44dp) -->
    <FrameLayout
        android:id="@+id/layout_company_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_company_avatar">

        <TextView
            android:id="@+id/tv_company_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/exp_tag_text"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Z" />

        <ImageView
            android:id="@+id/iv_company_fallback_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_description"
            android:visibility="gone"
            app:tint="@color/exp_tag_text" />
    </FrameLayout>

    <!-- Details Column (Full remaining horizontal width) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Company Name (Primary Discriminator Headline) -->
        <TextView
            android:id="@+id/tv_card_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/app_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Zomato" />

        <!-- Role Headline -->
        <TextView
            android:id="@+id/tv_card_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:textColor="@color/app_text_muted"
            android:textSize="13.5sp"
            tools:text="Flutter Developer | Mobile Application Developer" />

        <!-- Expiration / Age Badge (Earliest Expiration) -->
        <TextView
            android:id="@+id/tv_card_expiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#D97706"
            android:textSize="12sp"
            tools:text="⏱ Expires in 6 days · Created 11 Nov" />
    </LinearLayout>

    <!-- Trailing Actions Column (Top: Delete, Bottom: Navigation / QR, Vertically Aligned Center-to-Center) -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Manual Delete Button (Top-Right Corner) -->
        <ImageButton
            android:id="@+id/btn_delete_showcase"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Showcase"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="#EF4444" />

        <!-- Mode-Specific Trailing Action (VISUALISE: Arrow, SHOW_QR: Clean QR Icon) -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal">

            <!-- VISUALISE Mode: Right Arrow Chevron (Identical 32dp bounds & 5dp padding) -->
            <ImageView
                android:id="@+id/iv_action_arrow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#94A3B8" />

            <!-- SHOW_QR Mode: Clean QR Code Icon (No background, No text, Exactly Aligned) -->
            <ImageView
                android:id="@+id/iv_action_qr"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:padding="4dp"
                android:src="@drawable/ic_qr_code"
                android:visibility="gone"
                app:tint="@color/app_primary" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
