<?xml version="1.0" encoding="utf-8"?>
<!-- Single bullet row with 4dp circular #2563EB dot and 14sp text matching Stitch design -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal">

    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_bullet_dot" />

    <TextView
        android:id="@+id/tv_bullet_text"
        style="@style/TextAppearance.ResumeVisualiser.Exp.Bullet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Architected offline-first local synchronization engines and reactive client state management." />

</LinearLayout>

