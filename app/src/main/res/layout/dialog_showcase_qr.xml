<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle (Material 3 Rounded Capsule Bar) -->
    <View
        android:id="@+id/view_drag_handle"
        android:layout_width="40dp"
        android:layout_height="4.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Row 1: Header Title horizontally aligned with Save & Share Action Buttons -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title: Your Showcase is Ready! -->
        <TextView
            android:id="@+id/tv_qr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/layout_top_actions"
            android:fontFamily="sans-serif-medium"
            android:paddingEnd="12dp"
            android:text="@string/title_showcase_ready"
            android:textColor="@color/app_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Top Right Action Icons: Save to Gallery & Share QR Image -->
        <LinearLayout
            android:id="@+id/layout_top_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Save / Download QR to Gallery -->
            <ImageButton
                android:id="@+id/btn_action_save_qr"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button_circle"
                android:contentDescription="@string/cd_save_qr"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_save"
                app:tint="@color/app_primary" />

            <!-- Share QR Image Across Device Apps -->
            <ImageButton
                android:id="@+id/btn_action_share_qr"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button_circle"
                android:contentDescription="@string/cd_share_qr"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share"
                app:tint="@color/app_primary" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Row 2: Subtitle Spans Full Width Naturally Without Squeeze -->
    <TextView
        android:id="@+id/tv_qr_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="@string/subtitle_showcase_ready"
        android:textColor="@color/app_text_muted"
        android:textSize="13sp" />

    <!-- QR Code Display Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_qr_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardPreventCornerOverlap="true">

        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_margin="14dp"
            android:contentDescription="@string/cd_qr_code"
            android:scaleType="fitCenter" />
    </androidx.cardview.widget.CardView>

    <!-- Primary Action: View Visualiser Button (Visible only during celebration post-compile) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_qr_view_visualiser"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:background="@drawable/bg_button_primary"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="textEnd"
        app:iconPadding="8dp"
        app:iconTint="@android:color/white"
        android:fontFamily="sans-serif-medium"
        android:text="@string/btn_view_visualiser"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
