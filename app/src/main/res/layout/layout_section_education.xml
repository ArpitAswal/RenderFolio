<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/section_education_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:contentDescription="@string/cd_section_education"
    android:layout_marginTop="28dp">

    <!-- Section Header Title -->
    <TextView
        android:id="@+id/tv_education_title"
        style="@style/TextAppearance.ResumeVisualiser.Section.Header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="12dp"
        android:text="@string/section_title_education" />

    <!-- Container for Dynamically Added Education Entries -->
    <LinearLayout
        android:id="@+id/container_education_entries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
