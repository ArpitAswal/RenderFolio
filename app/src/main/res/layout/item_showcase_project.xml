<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- Title and Live Demo Button Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvProjectTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/app_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProjectDemo"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:text="↗ Live Demo"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:strokeColor="@color/accent_blue"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- Project Description -->
    <TextView
        android:id="@+id/tvProjectDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/app_text_muted"
        android:textSize="13sp" />

    <!-- Tech Stack Pills -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupProjectTech"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleLine="false" />

</LinearLayout>
