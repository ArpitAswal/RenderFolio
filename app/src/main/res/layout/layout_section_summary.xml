<?xml version="1.0" encoding="utf-8"?>
<!-- Section 2 Container: Hosts the header label, editorial summary, and thematic watermark -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section_summary_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <!-- Faded Thematic Background Watermark Artwork (Isometric Device from Stitch design) -->
    <ImageView
        android:id="@+id/iv_summary_watermark"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-24dp"
        android:layout_marginEnd="-28dp"
        android:alpha="0.75"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_watermark_summary" />

    <!-- Content Column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Section Header Title: PROFESSIONAL SUMMARY -->
        <TextView
            android:id="@+id/tv_summary_title"
            style="@style/TextAppearance.ResumeVisualiser.Section.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_description_16"
            app:drawableTint="@color/summary_section_title"
            android:text="@string/section_title_professional_summary" />

        <!-- 2. Clean Borderless Summary Narrative directly on canvas (No Card or Border line) -->
        <TextView
            android:id="@+id/tv_summary_body"
            style="@style/TextAppearance.ResumeVisualiser.Summary.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_section_summary" />

    </LinearLayout>

</FrameLayout>
