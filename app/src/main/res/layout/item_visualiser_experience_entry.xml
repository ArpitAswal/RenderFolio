<?xml version="1.0" encoding="utf-8"?>
<!-- Single Experience Item with Company, Role, Duration (No Dot), Bullets, and Deliverables -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_experience_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Company Name Headline (17sp Bold, #0F172A, line height 24sp) -->
    <TextView
        android:id="@+id/tv_entry_company"
        style="@style/TextAppearance.ResumeVisualiser.Exp.Role"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Apex Technologies Inc." />

    <!-- Role & Tenure Sub-Header (4dp below company: Role on left, Duration on right, No Dot) -->
    <LinearLayout
        android:id="@+id/layout_entry_role_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_entry_role"
            style="@style/TextAppearance.ResumeVisualiser.Exp.Company"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Senior Mobile Engineer" />

        <TextView
            android:id="@+id/tv_entry_duration"
            style="@style/TextAppearance.ResumeVisualiser.Exp.Duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            tools:text="2024 — Present" />
    </LinearLayout>

    <!-- Bulleted Responsibilities (8dp below sub-header) -->
    <LinearLayout
        android:id="@+id/container_entry_bullets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <!-- Client Deliverables Section (14dp vertical gap below bullets) -->
    <LinearLayout
        android:id="@+id/layout_entry_deliverables"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_deliverables_label"
            style="@style/TextAppearance.ResumeVisualiser.Exp.DeliverablesHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/exp_deliverables_title" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_entry_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacing="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />
    </LinearLayout>

    <!-- Hairline Divider (24dp top and bottom margins between entries, hidden on last item) -->
    <View
        android:id="@+id/divider_entry"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@color/exp_divider" />

</LinearLayout>
