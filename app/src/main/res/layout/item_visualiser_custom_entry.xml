<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_custom_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <!-- 1. Item Title Headline (17sp Bold Inter #0F172A, full-width) -->
    <TextView
        android:id="@+id/tv_entry_custom_title"
        style="@style/TextAppearance.ResumeVisualiser.Custom.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Google Associate Android Developer (AAD)" />

    <!-- 2. Metadata Sub-Header Row: Subtitle/Issuer on left, Duration/Period on right (matching Professional Experience) -->
    <LinearLayout
        android:id="@+id/layout_entry_custom_metadata_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_entry_custom_subtitle"
            style="@style/TextAppearance.ResumeVisualiser.Custom.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            tools:text="Google Developers Certification"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_entry_custom_period"
            style="@style/TextAppearance.ResumeVisualiser.Exp.Duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="2023"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Narrative Description -->
    <TextView
        android:id="@+id/tv_entry_custom_description"
        style="@style/TextAppearance.ResumeVisualiser.Custom.Description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        tools:text="Demonstrated comprehensive proficiency in Android architecture, asynchronous processing, and UI development."
        tools:visibility="visible" />

    <!-- Bullets Container (Inflating ItemVisualiserBulletRowBinding) -->
    <LinearLayout
        android:id="@+id/container_entry_custom_bullets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Deliverable / Credential Link Chips Dock -->
    <LinearLayout
        android:id="@+id/layout_custom_deliverables"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_custom_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="6dp" />
    </LinearLayout>

    <!-- Divider between items (hidden on the last item) -->
    <View
        android:id="@+id/divider_custom_entry"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@color/exp_divider" />

</LinearLayout>
