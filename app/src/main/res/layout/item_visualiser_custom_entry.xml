<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_custom_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <!-- Row: Title and Date/Period -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_entry_custom_title"
            style="@style/TextAppearance.ResumeVisualiser.Custom.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_entry_custom_period"
            style="@style/TextAppearance.ResumeVisualiser.Exp.Duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Subtitle / Issuer / Clickable Link -->
    <TextView
        android:id="@+id/tv_entry_custom_subtitle"
        style="@style/TextAppearance.ResumeVisualiser.Custom.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <!-- Description -->
    <TextView
        android:id="@+id/tv_entry_custom_description"
        style="@style/TextAppearance.ResumeVisualiser.Custom.Description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <!-- Bullets Container -->
    <LinearLayout
        android:id="@+id/container_entry_custom_bullets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Divider between items (hidden on the last item) -->
    <View
        android:id="@+id/divider_custom_entry"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/custom_item_divider" />

</LinearLayout>
