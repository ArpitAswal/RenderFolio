<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime permissions for reading local storage / documents -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Network permissions for Firebase Cloud Sync and Deep Link verification -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.StructureVerificationActivity"
            android:exported="false"
            android:label="Structure Verification"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.ResumeVisualiserActivity"
            android:exported="true"
            android:label="Resume Visualiser"
            android:theme="@style/Theme.ResumeVisualiser">
            <!-- Web Deep Link: https://lightweight-firebase-projects.web.app/r/{id} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="lightweight-firebase-projects.web.app"
                    android:pathPrefix="/r/" />
                <data
                    android:scheme="https"
                    android:host="renderfolio.web.app"
                    android:pathPrefix="/r/" />
                <data
                    android:scheme="https"
                    android:host="resumeshowcase.web.app"
                    android:pathPrefix="/r/" />
            </intent-filter>

            <!-- Custom URI Scheme: renderfolio://r/{id} and resumeshowcase://r/{id} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="renderfolio"
                    android:host="r" />
                <data
                    android:scheme="resumeshowcase"
                    android:host="r" />
            </intent-filter>
        </activity>

        <!-- Secure FileProvider for sharing QR code images to external apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
